{
  "name": "deutsch-woerter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "predev": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
